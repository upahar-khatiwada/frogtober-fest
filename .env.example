# --- Database ---
POSTGRES_USER=tenderly
POSTGRES_PASSWORD=tenderly
POSTGRES_DB=tenderly
DATABASE_URL=postgresql://tenderly:tenderly@db:5432/tenderly

# --- Ollama (CLAUDE.md hard rule 1: open-weight models only) ---
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen2.5:7b-instruct
EMBED_MODEL=bge-m3
# Context window per chat call (Ollama's default truncates long Devanagari notices). 0 = Ollama default.
LLM_NUM_CTX=8192

# --- Live tender scraper (bonus; the demo uses data/seed_tenders) ---
# A URL or email appended to the scraper's User-Agent so site admins can reach you.
SCRAPER_CONTACT=
# Minimum seconds between requests (robots.txt Crawl-delay wins if larger).
SCRAPER_MIN_DELAY_S=10

# --- Matching (company policy knobs, not procurement law) ---
# score >= threshold -> pursue (matched); below -> skipped (Compliance does not run)
MATCH_THRESHOLD=60
# final score = weight * LLM semantic score + (1 - weight) * deterministic fit points
MATCH_LLM_WEIGHT=0.6
# hard skip when estimated cost > this multiple of average annual turnover
MATCH_MAX_COST_TO_TURNOVER=2.0

# --- CORS: web origin the API accepts requests from ---
WEB_ORIGIN=http://localhost:3000

# --- Frontend: where the browser reaches the API ---
NEXT_PUBLIC_API_URL=http://localhost:8000