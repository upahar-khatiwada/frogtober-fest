# --- Database ---
POSTGRES_USER=tenderly
POSTGRES_PASSWORD=tenderly
POSTGRES_DB=tenderly
DATABASE_URL=postgresql://tenderly:tenderly@db:5432/tenderly

# --- Ollama (CLAUDE.md hard rule 1: open-weight models only) ---
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen2.5:7b-instruct
EMBED_MODEL=bge-m3

# --- Live tender scraper (bonus; the demo uses data/seed_tenders) ---
# A URL or email appended to the scraper's User-Agent so site admins can reach you.
SCRAPER_CONTACT=
# Minimum seconds between requests (robots.txt Crawl-delay wins if larger).
SCRAPER_MIN_DELAY_S=10

# --- CORS: web origin the API accepts requests from ---
WEB_ORIGIN=http://localhost:3000

# --- Frontend: where the browser reaches the API ---
NEXT_PUBLIC_API_URL=http://localhost:8000